{
  "name": "payload-pg-ch",
  "version": "0.1.0",
  "description": "Payload CMS document-DB adapter: PostgreSQL + ClickHouse",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "payload-pg-ch": "./dist/cli/migrate.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./remote": {
      "import": "./dist/remote/index.js",
      "types": "./dist/remote/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "migrate": "node --import tsx src/cli/migrate.ts",
    "migrate:up": "node --import tsx src/cli/migrate.ts up",
    "migrate:down": "node --import tsx src/cli/migrate.ts down",
    "migrate:status": "node --import tsx src/cli/migrate.ts status",
    "migrate:seed": "node --import tsx src/cli/migrate.ts seed",
    "migrate:fresh": "node --import tsx src/cli/migrate.ts fresh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:ci": "docker compose -f docker-compose.test.yml up -d --wait && vitest run; docker compose -f docker-compose.test.yml down",
    "lint": "eslint src/",
    "check": "tsc --noEmit && eslint src/ && vitest run"
  },
  "peerDependencies": {
    "payload": "^3.0.0"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "sqids": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
